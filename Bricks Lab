end

local function section(text)
    return create("TextLabel", {
        Size = UDim2.new(1, -4, 0, 25),
        BackgroundTransparency = 1,
        Text = string.upper(text),
        TextColor3 = PURPLE,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, content)
end

local function card(height)
    local frame = create("Frame", {
        Size = UDim2.new(1, -4, 0, height),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
    }, content)
    round(frame, 11)
    return frame
end

local function label(parent, text, position, size, textSize, color)
    return create("TextLabel", {
        Position = position,
        Size = size,
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or WHITE,
        Font = Enum.Font.GothamMedium,
        TextSize = textSize or 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    }, parent)
end

local function makeToggle(parent, title, description, initial, callback)
    local frame = card(66)
    label(frame, title, UDim2.fromOffset(12, 9),
        UDim2.new(1, -80, 0, 20), 13)
    label(frame, description, UDim2.fromOffset(12, 32),
        UDim2.new(1, -85, 0, 23), 10, MUTED)

    local switch = create("TextButton", {
        Position = UDim2.new(1, -57, 0, 20),
        Size = UDim2.fromOffset(44, 25),
        BackgroundColor3 = initial and PURPLE
            or Color3.fromRGB(64, 56, 76),
        Text = initial and "ON" or "OFF",
        TextColor3 = WHITE,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
    }, frame)
    round(switch, 8)

    local value = initial
    switch.Activated:Connect(function()
        value = not value
        switch.Text = value and "ON" or "OFF"
        switch.BackgroundColor3 = value and PURPLE
            or Color3.fromRGB(64, 56, 76)
        callback(value)
    end)
    return switch
end

local function makeSlider(title, minimum, maximum, initial, callback)
    local frame = card(78)
    local valueLabel = label(frame, "", UDim2.new(1, -75, 0, 10),
        UDim2.fromOffset(62, 20), 12, PURPLE)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    label(frame, title, UDim2.fromOffset(12, 10),
        UDim2.new(1, -95, 0, 20), 13)

    local track = create("TextButton", {
        Position = UDim2.new(0, 12, 0, 46),
        Size = UDim2.new(1, -24, 0, 8),
        BackgroundColor3 = Color3.fromRGB(63, 52, 79),
        Text = "",
        AutoButtonColor = false,
    }, frame)
    round(track, 6)

    local fill = create("Frame", {
        Size = UDim2.new((initial-minimum)/(maximum-minimum), 0, 1, 0),
        BackgroundColor3 = PURPLE,
        BorderSizePixel = 0,
    }, track)
    round(fill, 6)

    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((initial-minimum)/(maximum-minimum), 0, 0.5, 0),
        Size = UDim2.fromOffset(15, 15),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
    }, track)
    round(knob, 8)

    local value = initial
    local function updateFromX(x)
        local fraction = math.clamp(
            (x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(minimum + fraction * (maximum-minimum) + 0.5)
        fill.Size = UDim2.new(fraction, 0, 1, 0)
        knob.Position = UDim2.new(fraction, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
        callback(value)
    end

    local dragging = false
    track.Activated:Connect(function()
        updateFromX(UIS:GetMouseLocation().X)
    end)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            updateFromX(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    valueLabel.Text = tostring(initial)
end

local function buildTab(tab)
    selectedTab = tab
    clearContent()

    for name, button in pairs(tabButtons) do
        button.BackgroundColor3 = name == tab
            and Color3.fromRGB(77, 49, 111)
            or PANEL
    end

    if tab == "Main" then
        section("Overview")

        local summary = card(76)
        label(summary, "Camera assist settings",
            UDim2.fromOffset(12, 10), UDim2.new(1, -24, 0, 22), 15)
        label(summary, "Configure the visual controls for your experience.",
            UDim2.fromOffset(12, 37), UDim2.new(1, -24, 0, 25), 11, MUTED)

        makeToggle(content, "Camera assist",
            "Master toggle for your game's camera mechanic",
            settings.AssistEnabled, function(v)
                settings.AssistEnabled = v
            end)

        section("Target preferences")
        makeSlider("Maximum range (studs)", 25, 300, settings.Range,
            function(v) settings.Range = v end)

        makeSlider("Camera smoothness", 1, 100, settings.Smoothness,
            function(v) settings.Smoothness = v end)

        makeToggle(content, "Team filter",
            "Exclude players on your team",
            settings.TeamCheck, function(v)
                settings.TeamCheck = v
            end)

    elseif tab == "Visuals" then
        section("Visual options")

        makeToggle(content, "FOV circle",
            "Show the camera field-of-view indicator",
            settings.ShowFOV, function(v)
                settings.ShowFOV = v
            end)

        makeSlider("FOV radius (pixels)", 40, 350, settings.FOV,
            function(v) settings.FOV = v end)

        makeToggle(content, "Visibility indicator",
            "Enable visibility display in your game UI",
            settings.VisibleOnly, function(v)
                settings.VisibleOnly = v
            end)

        section("Target HUD")
        local hud = card(90)
        label(hud, "TARGET STATUS", UDim2.fromOffset(12, 12),
            UDim2.new(1, -24, 0, 20), 12, PURPLE)
        label(hud, "No target selected",
            UDim2.fromOffset(12, 39), UDim2.new(1, -24, 0, 24), 14)
        label(hud, "Connect this panel to your game's target system.",
            UDim2.fromOffset(12, 65), UDim2.new(1, -24, 0, 18), 10, MUTED)

    elseif tab == "Settings" then
        section("Interface")
        makeToggle(content, "Open menu on start",
            "Display the control panel when you spawn",
            menuOpen, function(v)
                menuOpen = v
                window.Visible = v
            end)

        local keyCard = card(78)
        label(keyCard, "Menu keybind",
            UDim2.fromOffset(12, 12), UDim2.new(1, -24, 0, 22), 13)
        local keyButton = create("TextButton", {
            Position = UDim2.fromOffset(12, 42),
            Size = UDim2.new(1, -24, 0, 25),
            BackgroundColor3 = Color3.fromRGB(75, 52, 102),
            Text = settings.ToggleKey.Name .. "  ·  Click to change",
            TextColor3 = WHITE,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
        }, keyCard)
        round(keyButton, 7)

        keyButton.Activated:Connect(function()
            keyButton.Text = "Press a keyboard key..."
            local connection
            connection = UIS.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard
                    and input.KeyCode ~= Enum.KeyCode.Unknown then
                    settings.ToggleKey = input.KeyCode
                    keyButton.Text = input.KeyCode.Name .. "  ·  Click to change"
                    connection:Disconnect()
                end
            end)
        end)

        local reset = create("TextButton", {
            Size = UDim2.new(1, -4, 0, 42),
            BackgroundColor3 = Color3.fromRGB(85, 45, 103),
            Text = "RESET DEFAULT SETTINGS",
            TextColor3 = WHITE,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
        }, content)
        round(reset, 10)

        reset.Activated:Connect(function()
            settings.Range = 150
            settings.Smoothness = 50
            settings.FOV = 120
            settings.ShowFOV = true
            settings.TeamCheck = false
            settings.VisibleOnly = true
            settings.AssistEnabled = false
            settings.ToggleKey = Enum.KeyCode.RightShift
            buildTab("Settings")
        end)
    end
end

